// Club-local players (queue/modules/sessions-roster.md). A guest has a durable club identity and
// session history with no global profile; player_id is the optional cross-club link, never a grant to
// read private contacts. Names are not unique.

model ClubPlayer {
  id                   String    @id @db.Uuid
  clubId               String    @map("club_id") @db.Uuid
  /// Null for guests. Unique per club when set.
  playerId             String?   @map("player_id") @db.Uuid
  /// The shared entry (email + RTR ID) of an unclaimed person this record is for (D-2026-11-16-04).
  /// Kept after registration, when `player_id` is set too. Unique per club. Null: a guest, an older
  /// record with a phone and no email (Details required), or a registered player saved directly.
  sharedEntryId        String?   @map("shared_entry_id") @db.Uuid
  displayName          String    @map("display_name")
  /// The club's own nickname. For a guest or unclaimed player it is their nickname; for a
  /// registered player it is the club nickname (D-2026-11-18-02), returned to that club's Queue
  /// Master reads only, never to public, player, results or leaderboard reads.
  nickname             String?
  /// When the club first saved this player (Saved players "Added" sort/filter).
  addedAt              DateTime  @map("added_at") @db.Timestamptz(6)
  /// The club deleted this saved player (soft delete; history keeps the row). Null = current.
  removedAt            DateTime? @map("removed_at") @db.Timestamptz(6)
  /// Set with `removed_at` when the Queue Master confirmed "Same person as NAME?" (D-2026-11-16-04):
  /// this record moved into that saved player of the same club. Its finished history stays here and
  /// is reached through this redirect; live slots, waitlist spots and pending requests moved.
  linkedToClubPlayerId String?   @map("linked_to_club_player_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  revision             BigInt    @default(1)

  club            Club                    @relation(fields: [clubId], references: [id], onDelete: Restrict)
  player          Player?                 @relation(fields: [playerId], references: [id], onDelete: Restrict)
  sharedEntry     SharedPlayerEntry?      @relation(fields: [sharedEntryId], references: [id], onDelete: Restrict)
  linkedTo        ClubPlayer?             @relation("ClubPlayerMovedInto", fields: [clubId, linkedToClubPlayerId], references: [clubId, id], onDelete: Restrict)
  movedIn         ClubPlayer[]            @relation("ClubPlayerMovedInto")
  privateInput    ClubPlayerPrivateInput?
  rosterEntries   SessionPlayer[]
  waitlistEntries SessionWaitlistEntry[]
  joinRequests    SessionJoinRequest[]
  assessments     ClubAssessment[]
  claimLinks      ClubPlayerClaimLink[]

  facts        PlayerMatchFact[]
  summaries    ClubSessionPlayerSummary[]
  attributions PlayerHistoryAttribution[]

  @@unique([clubId, id])
  @@unique([clubId, playerId])
  @@unique([clubId, sharedEntryId])
  @@index([clubId, displayName, id])
  @@index([playerId])
  @@index([sharedEntryId])
  @@index([clubId, linkedToClubPlayerId])
  @@map("club_players")
}

enum ClubPlayerInputState {
  pending
  resolved
  conflicted
  discarded

  @@map("club_player_input_state")
}

/// Private operator intake (phone/email/preset fields) awaiting identity resolution. Never in a public
/// roster payload or download; known hidden contacts are not copied here. Purge policy is open.
model ClubPlayerPrivateInput {
  clubPlayerId     String               @id @map("club_player_id") @db.Uuid
  clubId           String               @map("club_id") @db.Uuid
  phoneE164        String?              @map("phone_e164")
  email            String?
  /// Preset identity fields typed by the operator (validated by the service).
  presetFields     Json?                @map("preset_fields")
  capturedAt       DateTime             @map("captured_at") @db.Timestamptz(6)
  state            ClubPlayerInputState @default(pending)
  resolvedPlayerId String?              @map("resolved_player_id") @db.Uuid
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  revision         BigInt               @default(1)

  clubPlayer     ClubPlayer @relation(fields: [clubId, clubPlayerId], references: [clubId, id], onDelete: Restrict)
  resolvedPlayer Player?    @relation("ClubPlayerInputResolved", fields: [resolvedPlayerId], references: [id], onDelete: Restrict)

  @@unique([clubId, clubPlayerId])
  @@index([state, capturedAt])
  @@index([phoneE164])
  @@index([resolvedPlayerId])
  @@map("club_player_private_inputs")
}
