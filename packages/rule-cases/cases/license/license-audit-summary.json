      "input": {
        "args": [
          "Activated",
          {
            "id": "2026-10-27-Monthly",
            "clubId": "club",
            "plan": "Monthly",
            "startsAt": "2026-10-27",
            "endsAt": "2026-11-26",
            "amountMinor": 0,
            "currency": "PHP",
            "paidOn": "2026-10-27",
            "paymentReference": "",
            "activatedAt": "2026-10-27T09:00:00+08:00",
