    "base": []
  },
  "snapshot": [
    {
      "name": "player_contact_change_requests",
      "sql": "SELECT id, player_id, field, source, status, proposed_value, original_value, original_contact_revision::text AS original_contact_revision, requested_at, submitted_by_admin_id, source_command_id, reviewed_by_admin_id, reviewed_at, approved_at, rejected_at, superseded_at, (provider_operation_ref IS NOT NULL) AS has_ref, application_attempts, last_attempt_at, provider_applied_at, applied_at, failure_code, resolution_note, updated_at, revision::text AS revision FROM player_contact_change_requests ORDER BY source_command_id",
      "redact": [
        "id"
      ]
    },
    {
      "name": "player_private_contacts",
      "sql": "SELECT player_id, phone_e164, email, phone_verified_at, email_verified_at, updated_at, revision::text AS revision FROM player_private_contacts ORDER BY player_id",
      "redact": []
    },
    {
      "name": "player_accounts",
      "sql": "SELECT player_id, contact_sync_status, contact_sync_version::text AS contact_sync_version, disabled_at, updated_at, revision::text AS revision FROM player_accounts ORDER BY player_id",
      "redact": []
    },
    {
      "name": "player_logins",
      "sql": "SELECT id, login_key FROM auth_identities WHERE audience = 'player' ORDER BY id",
      "redact": []
    },
    {
      "name": "admin_player_email_edits",
      "sql": "SELECT player_id, original_email, proposed_email, state FROM admin_player_email_edits ORDER BY player_id, proposed_email, state",
      "redact": []
    },
    {
      "name": "admin_audit_events",
      "sql": "SELECT id, actor_admin_id, action, target_type, target_id, source_command_id, occurred_at, metadata - 'requestId' AS metadata, (metadata ? 'requestId') AS has_request, COALESCE(metadata->>'requestId' IN (SELECT id::text FROM player_contact_change_requests), false) AS request_known FROM admin_audit_events ORDER BY action, target_id, source_command_id NULLS FIRST, metadata::text, occurred_at",
      "redact": [
        "id"
      ]
    },
    {
      "name": "player_notifications",
      "sql": "SELECT id, player_id, kind, title, body, target, source_type, COALESCE(source_id IN (SELECT id FROM player_contact_change_requests), false) AS source_is_request, read_at FROM player_notifications ORDER BY player_id, kind, source_type, title, body",
      "redact": [
        "id"
      ]
    }
  ],
