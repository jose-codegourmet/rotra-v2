# Server-only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
# Runtime: Supabase transaction pooler (port 6543). Used by the app's Prisma client.
DATABASE_URL="postgresql://<runtime_role>:<password>@<pooler-host>:6543/postgres"
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Migrations / CLI only: direct or session connection (port 5432). Not loaded by the apps.
DIRECT_URL="postgresql://<migration_role>:<password>@<direct-host>:5432/postgres"
# mock (default): in-memory mock store and mock cookies. real: Supabase sessions + database;
# mock cookies and demo accounts are rejected.
ROTRA_DATA_MODE=mock
# Supabase Auth, read server-side only (session verification and cookie refresh).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable key>"
