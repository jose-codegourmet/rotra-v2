// Trusted club hosts and session hosts (epic #1002, D-2026-11-22-01). Hosting is informational, never
// authorization: club credentials stay the only way to operate the Queue app, and nothing here grants
// a role, a permission or a sign-in.

/// A club's trusted-host list, drawn from its saved players (club_players): guests and unclaimed
/// players can be trusted hosts too. One current row per (club, saved player), enforced by a partial
/// unique index in SQL (`removed_at IS NULL`). Removing a trusted host sets `removed_at` and never
/// touches the saved player or any session's host records.
model ClubTrustedHost {
  id           String    @id @db.Uuid
  clubId       String    @map("club_id") @db.Uuid
  clubPlayerId String    @map("club_player_id") @db.Uuid
  /// When the club put this saved player on its trusted-host list.
  addedAt      DateTime  @map("added_at") @db.Timestamptz(6)
  /// The club took them off the list. Null = currently trusted.
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  revision     BigInt    @default(1)

  club       Club       @relation(fields: [clubId], references: [id], onDelete: Restrict)
  clubPlayer ClubPlayer @relation(fields: [clubId, clubPlayerId], references: [clubId, id], onDelete: Restrict)

  @@unique([clubId, id])
  @@index([clubId, clubPlayerId])
  @@map("club_trusted_hosts")
}

/// A Queue Session's hosts (#1004): saved players of the club assigned to host that one session. Shown,
/// never a permission. Assigning a host also gives them a roster place (a slot, or the waitlist when
/// every slot is taken) unless they are already registered; that roster row is separate, so removing a
/// host (`removed_at`) never removes their registration and withdrawing as a player never ends the
/// host row. One current row per (session, saved player), enforced by a partial unique index in SQL.
/// Finished sessions keep their hosts (#1008): the rows current at the end are frozen with a name
/// snapshot, so trusted-host removal, saved-player deletion or a Same person move never changes them.
model SessionHost {
  id           String    @id @db.Uuid
  clubId       String    @map("club_id") @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  clubPlayerId String    @map("club_player_id") @db.Uuid
  /// When the saved player was assigned as a host of this session.
  assignedAt   DateTime  @map("assigned_at") @db.Timestamptz(6)
  /// The host designation ended. Null = current host. Their roster row is untouched.
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(6)
  /// The host's name when assigned (#1008): the ROTRA full name for a linked record, else the saved
  /// player's display name. Refreshed once more when the session ends, then frozen with the row.
  nameSnapshot String    @map("name_snapshot")
  /// Set when the session ended (Session done or Mark session invalid) on the rows current then: the
  /// finished session's hosts. A guard trigger keeps a frozen row unchanged and undeleted. Null on a
  /// row removed before the end, and on every row of a session still open.
  frozenAt     DateTime? @map("frozen_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  revision     BigInt    @default(1)

  club       Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)
  session    QueueSession @relation(fields: [clubId, sessionId], references: [clubId, id], onDelete: Restrict)
  clubPlayer ClubPlayer   @relation(fields: [clubId, clubPlayerId], references: [clubId, id], onDelete: Restrict)

  @@unique([clubId, id])
  @@index([clubId, sessionId])
  @@index([clubId, clubPlayerId])
  @@map("session_hosts")
}
