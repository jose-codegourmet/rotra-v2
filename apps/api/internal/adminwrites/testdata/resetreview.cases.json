      "sql": "SELECT id, email, player_id, status, requested_at, reviewed_by_admin_id, reviewed_at, auth_subject, (token_digest IS NOT NULL) AS has_link, consumed_at, (issuance_id IS NOT NULL) AS has_lease, issuance_started_at, updated_at, revision::text AS revision FROM player_password_reset_requests ORDER BY id",
      "redact": []
    },
    {
      "name": "admin_audit_events",
      "sql": "SELECT id, actor_admin_id, action, target_type, target_id, source_command_id, occurred_at, metadata - 'requestId' AS metadata, (metadata ? 'requestId') AS has_request, COALESCE(metadata->>'requestId' IN (SELECT id::text FROM player_contact_change_requests), false) AS request_known FROM admin_audit_events ORDER BY action, target_id, source_command_id NULLS FIRST, metadata::text, occurred_at",
      "redact": [
        "id"
      ]
