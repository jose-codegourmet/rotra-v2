    "bulk_players": [
      "INSERT INTO players (id, full_name, nickname, profile_visibility, updated_at) SELECT ('c0000000-0000-4000-8000-' || lpad(n::text, 12, '0'))::uuid, 'Bulk Player ' || n, NULL, 'public', now() FROM generate_series(1, 60) AS n",
      "INSERT INTO player_rank_current (player_id, skill_level_id, numeric_rank, state, input_counts, policy_version_id, algorithm_version, window_start, window_end, calculated_at, input_watermark, next_recheck_at, recent_standard_match_count, leaderboard_eligible, updated_at) SELECT ('c0000000-0000-4000-8000-' || lpad(n::text, 12, '0'))::uuid, 1, n / 10.0, 'established', '{}'::jsonb, (SELECT id FROM ranking_policy_versions ORDER BY version LIMIT 1), 'rank-test-v1', TIMESTAMPTZ '2026-01-01 00:00:00+00', TIMESTAMPTZ '2026-11-01 00:00:00+00', TIMESTAMPTZ '2026-11-01 00:00:00+00', 1, TIMESTAMPTZ '2026-12-01 00:00:00+00', 12, true, now() FROM generate_series(1, 60) AS n"
    ]
  },
