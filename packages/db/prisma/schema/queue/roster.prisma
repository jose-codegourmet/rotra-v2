// Roster entries (slots), waitlist and guest join requests (queue/modules/sessions-roster.md).
//
// Roster identity (proposal pending #245): one session_players row per (session, club player) for
// the session's lifetime. Demotion to the waitlist or removal in preparation releases the row
// (released_at) instead of deleting it, so paid marks and assessments that key on the entry are never
// cascaded or orphaned, and regaining a slot reactivates the same entry. Waitlist rows are deleted on
// Give slot; they carry ordering evidence only.

enum RosterReleaseReason {
  demoted
  removed

  @@map("roster_release_reason")
}

model SessionPlayer {
  id               String               @id @db.Uuid
  clubId           String               @map("club_id") @db.Uuid
  sessionId        String               @map("session_id") @db.Uuid
  clubPlayerId     String               @map("club_player_id") @db.Uuid
  /// Historical snapshot of the global link at entry; no forced profile for guests.
  playerIdAtEntry  String?              @map("player_id_at_entry") @db.Uuid
  nameSnapshot     String               @map("name_snapshot")
  /// False when added in preparation, true when added to an active session.
  present          Boolean              @default(false)
  presentChangedAt DateTime             @map("present_changed_at") @db.Timestamptz(6)
  /// Selected roster assessment for this exact entry (scoped FK). Null only during the insert
  /// transaction that also writes the assessment, or for a prepared row without a level (#245).
  assessmentId     String?              @map("assessment_id") @db.Uuid
  skillLevelId     Int?                 @map("skill_level_id") @db.SmallInt
  /// Set at start or late entry; level and assessment are immutable afterwards (trigger in SQL).
  levelLockedAt    DateTime?            @map("level_locked_at") @db.Timestamptz(6)
  /// Slot order is confirmed_at (first come, first served).
  confirmedAt      DateTime             @map("confirmed_at") @db.Timestamptz(6)
  joinedAt         DateTime             @map("joined_at") @db.Timestamptz(6)
  /// When the slot exceeded the budget at Give slot time (over budget), else null.
  overBudgetAt     DateTime?            @map("over_budget_at") @db.Timestamptz(6)
  releasedAt       DateTime?            @map("released_at") @db.Timestamptz(6)
  releaseReason    RosterReleaseReason? @map("release_reason")
  /// No show (cancelled) (#839): set after Start on a live entry that will not come; never together
  /// with released_at (CHECK in SQL). The live roster excludes it; Back to roster clears it.
  noShowAt         DateTime?            @map("no_show_at") @db.Timestamptz(6)
  /// I'm here (D-2026-11-09-03): when the signed-in Player last set Present themselves. The roster
  /// shows “checked in themselves” only while present and present_changed_at is not later (the
  /// Queue Master's last action wins). History, never cleared.
  selfCheckedInAt  DateTime?            @map("self_checked_in_at") @db.Timestamptz(6)
  /// I'm leaving: when the signed-in Player last turned Present off themselves. “Left” shows only
  /// while not present and present_changed_at is not later. History, never cleared.
  leftAt           DateTime?            @map("left_at") @db.Timestamptz(6)
  /// Set games played (#717): requested − games counted from completed matches at override time.
  /// Displayed games played = counted + this, floored at 0; may be negative. Session-running aid only.
  gamesAdjustment  Int                  @default(0) @map("games_adjustment")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  revision         BigInt               @default(1)

  session            QueueSession     @relation(fields: [clubId, sessionId], references: [clubId, id], onDelete: Restrict)
  clubPlayer         ClubPlayer       @relation(fields: [clubId, clubPlayerId], references: [clubId, id], onDelete: Restrict)
  playerAtEntry      Player?          @relation("SessionPlayerAtEntry", fields: [playerIdAtEntry], references: [id], onDelete: Restrict)
  skillLevel         SkillLevel?      @relation(fields: [skillLevelId], references: [id], onDelete: Restrict)
  selectedAssessment ClubAssessment?  @relation("SelectedAssessment", fields: [clubId, sessionId, id, assessmentId], references: [clubId, sessionId, sessionPlayerId, id], onDelete: Restrict)
  assessments        ClubAssessment[] @relation("AssessmentEntry")

  participations MatchParticipation[]
  activeHold     ActivePlayerHold?

  matchRequests     SessionMatchRequest[]     @relation("MatchRequestRequester")
  matchRequestSpots SessionMatchRequestSpot[] @relation("MatchRequestSpot")

  paymentMark SessionPaymentMark?

  dropOutNotices SessionDropOutNotice[]

  facts   PlayerMatchFact[]
  summary ClubSessionPlayerSummary?

  @@unique([clubId, sessionId, id])
  @@unique([sessionId, clubPlayerId])
  @@unique([sessionId, playerIdAtEntry])
  @@index([sessionId, present, id])
  @@index([clubId, clubPlayerId])
  @@map("session_players")
}

/// Waitlist order (proposal pending #245): demoted entries first, latest demotion batch at the front,
/// each batch in its original slot order (demoted_confirmed_at); then everyone else by added_at; id
/// breaks ties. No position column and no timestamp rewriting.
model SessionWaitlistEntry {
  id                 String    @id @db.Uuid
  clubId             String    @map("club_id") @db.Uuid
  sessionId          String    @map("session_id") @db.Uuid
  clubPlayerId       String    @map("club_player_id") @db.Uuid
  /// Level chosen when added; becomes the roster level when given a slot.
  skillLevelId       Int?      @map("skill_level_id") @db.SmallInt
  /// Historical arrival/entry time (a confirmed join request uses its requested_at).
  addedAt            DateTime  @map("added_at") @db.Timestamptz(6)
  /// Set when a budget reduction moved this player off the roster.
  demotedAt          DateTime? @map("demoted_at") @db.Timestamptz(6)
  /// The released roster entry's confirmed_at, keeping relative joining order within a batch.
  demotedConfirmedAt DateTime? @map("demoted_confirmed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  revision           BigInt    @default(1)

  session    QueueSession @relation(fields: [clubId, sessionId], references: [clubId, id], onDelete: Restrict)
  clubPlayer ClubPlayer   @relation(fields: [clubId, clubPlayerId], references: [clubId, id], onDelete: Restrict)
  skillLevel SkillLevel?  @relation(fields: [skillLevelId], references: [id], onDelete: Restrict)

  @@unique([sessionId, clubPlayerId])
  @@map("session_waitlist")
}

enum StatedBand {
  beginner
  intermediate
  advanced
  unsure

  @@map("stated_band")
}

/// The player's choice on a join request (D-2026-11-11-02): Join a slot, Be waitlisted, or a
/// waitlisted Player asking for a slot. Rows from before the choice read `slot`.
enum JoinRequestPlacement {
  slot
  waitlist
  from_waitlist

  @@map("join_request_placement")
}

enum JoinRequestStatus {
  pending
  confirmed
  declined
  /// Pending requests closed by Start or Cancel session (not a decline).
  closed
  /// A signed-in Player withdrew their own pending request (Cancel request, D-2026-11-09-02).
  cancelled

  @@map("join_request_status")
}

/// Request from the public session link: a guest's form, or a signed-in Player's one tap (player_id
/// set, name copied from the profile). Never inserts roster/waitlist rows by itself.
model SessionJoinRequest {
  id                String               @id @db.Uuid
  clubId            String               @map("club_id") @db.Uuid
  sessionId         String               @map("session_id") @db.Uuid
  name              String
  nickname          String?
  /// Visible to the club only, never on the public page.
  phoneE164         String?              @map("phone_e164")
  statedBand        StatedBand           @map("stated_band")
  /// Join a slot (`slot`), Be waitlisted (`waitlist`) or Join from waitlist (`from_waitlist`).
  /// `slot` is refused while the roster is at the budget; `from_waitlist` sets club_player_id at creation.
  placement         JoinRequestPlacement @default(slot)
  status            JoinRequestStatus    @default(pending)
  requestedAt       DateTime             @map("requested_at") @db.Timestamptz(6)
  decidedAt         DateTime?            @map("decided_at") @db.Timestamptz(6)
  /// Device that confirmed/declined, from the same club (scoped FK added by F07.12).
  decidedByDeviceId String?              @map("decided_by_device_id") @db.Uuid
  /// The club player created on confirm (or the Player's own saved player).
  clubPlayerId      String?              @map("club_player_id") @db.Uuid
  /// The signed-in Player who sent it (D-2026-11-09-02); null for a guest. One pending per Player
  /// and session (partial unique index in the migration).
  playerId          String?              @map("player_id") @db.Uuid
  /// The Session invite the link carried (`?invite=`), read as “Invited by NAME”
  /// (D-2026-11-09-08); null when it carried none.
  inviteCodeId      String?              @map("invite_code_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  revision          BigInt               @default(1)

  session    QueueSession       @relation(fields: [clubId, sessionId], references: [clubId, id], onDelete: Restrict)
  clubPlayer ClubPlayer?        @relation(fields: [clubId, clubPlayerId], references: [clubId, id], onDelete: Restrict)
  decidedBy  Device?            @relation(fields: [clubId, decidedByDeviceId], references: [clubId, id], onDelete: Restrict)
  player     Player?            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  inviteCode SessionInviteCode? @relation(fields: [inviteCodeId], references: [id], onDelete: Restrict)

  @@index([sessionId, status, requestedAt])
  @@index([playerId])
  @@index([inviteCodeId])
  @@map("session_join_requests")
}

enum DropOutNoticeStatus {
  open
  closed

  @@map("drop_out_notice_status")
}

enum DropOutNoticeDecision {
  kept
  removed

  @@map("drop_out_notice_decision")
}

/// I can't make it (D-2026-11-09-03): a confirmed signed-in Player tells the Queue Master before the
/// start. The slot stays until the Queue Master acts: Keep closes it as `kept`, Remove from roster
/// closes it as `removed` and releases the roster entry in one transaction. Finishing or cancelling
/// the session closes it with no decision. One open notice per roster entry (partial unique index in
/// the migration); `decision` is set only on a notice closed by Keep or Remove (CHECK in SQL).
model SessionDropOutNotice {
  id               String                 @id @db.Uuid
  clubId           String                 @map("club_id") @db.Uuid
  sessionId        String                 @map("session_id") @db.Uuid
  sessionPlayerId  String                 @map("session_player_id") @db.Uuid
  /// The authenticated Player who sent it; linked to the roster entry's club player.
  playerId         String                 @map("player_id") @db.Uuid
  status           DropOutNoticeStatus    @default(open)
  decision         DropOutNoticeDecision?
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt         DateTime?              @map("closed_at") @db.Timestamptz(6)
  /// Device that decided it, from the same club; null when decided online in real mode or closed by
  /// the session ending.
  closedByDeviceId String?                @map("closed_by_device_id") @db.Uuid

  session  QueueSession  @relation(fields: [clubId, sessionId], references: [clubId, id], onDelete: Restrict)
  entry    SessionPlayer @relation(fields: [clubId, sessionId, sessionPlayerId], references: [clubId, sessionId, id], onDelete: Restrict)
  player   Player        @relation(fields: [playerId], references: [id], onDelete: Restrict)
  closedBy Device?       @relation(fields: [clubId, closedByDeviceId], references: [clubId, id], onDelete: Restrict)

  @@index([sessionId, status, createdAt])
  @@index([clubId, sessionId, sessionPlayerId])
  @@index([playerId])
  @@map("session_drop_out_notices")
}

/// Session invite (D-2026-11-09-08): one random code per Player and session, made the first time a
/// confirmed or waitlisted Player opens the invite card while the session is Prepared. Never the RTR
/// ID. Read by the public join flow to resolve `?invite=` into `session_join_requests.invite_code_id`.
model SessionInviteCode {
  id        String   @id @db.Uuid
  clubId    String   @map("club_id") @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session      QueueSession         @relation(fields: [clubId, sessionId], references: [clubId, id], onDelete: Restrict)
  player       Player               @relation(fields: [playerId], references: [id], onDelete: Restrict)
  joinRequests SessionJoinRequest[]

  @@unique([sessionId, playerId])
  @@map("session_invite_codes")
}
