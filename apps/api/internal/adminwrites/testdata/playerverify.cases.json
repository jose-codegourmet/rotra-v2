  "snapshot": [
    {
      "name": "players",
      "sql": "SELECT id, full_name, nickname, avatar_ref, avatar_previous_ref, profile_state, hide_phone_from_clubs, profile_visibility, show_profile_stats, banner_id, experience_months, experience_recorded_at, personal_details, details_version, updated_at, revision::text AS revision, verification_override, verification_override_by, verification_override_at FROM players ORDER BY id",
      "redact": []
    },
    {
      "name": "player_private_contacts",
      "sql": "SELECT player_id, phone_e164, email, phone_verified_at, email_verified_at, updated_at, revision::text AS revision FROM player_private_contacts ORDER BY player_id",
      "redact": []
    },
    {
      "name": "player_accounts",
      "sql": "SELECT player_id, contact_sync_status, contact_sync_version::text AS contact_sync_version, disabled_at, google_email, verification_reminder_read_at, updated_at, revision::text AS revision FROM player_accounts ORDER BY player_id",
      "redact": []
    },
    {
      "name": "player_social_links",
      "sql": "SELECT player_id, provider, url, updated_at FROM player_social_links ORDER BY player_id, provider",
      "redact": []
    },
    {
      "name": "player_id_allocations",
      "sql": "SELECT player_id, rtr_id, creating_club_id, location_code_id, country_code, city_code, sync_date::text AS sync_date, sequence FROM player_id_allocations ORDER BY player_id",
      "redact": []
    },
    {
      "name": "player_id_counters",
      "sql": "SELECT location_code_id, sync_date::text AS sync_date, last_sequence FROM player_id_counters ORDER BY location_code_id, sync_date",
      "redact": []
    },
    {
      "name": "shared_player_entries",
      "sql": "SELECT id, email, rtr_id, creating_club_id, location_code_id, country_code, city_code, sync_date::text AS sync_date, sequence, claimed_player_id, retired_at, updated_at, revision::text AS revision FROM shared_player_entries ORDER BY id",
      "redact": []
    },
    {
      "name": "club_players",
      "sql": "SELECT id, club_id, player_id, shared_entry_id, display_name, nickname, added_at, removed_at, updated_at, revision::text AS revision, EXISTS (SELECT 1 FROM admin_audit_events a WHERE a.action = 'player.created' AND a.target_id = club_players.id::text) AS audited, EXISTS (SELECT 1 FROM club_player_private_inputs i WHERE i.club_player_id = club_players.id AND i.club_id = club_players.club_id) AS has_input FROM club_players ORDER BY club_id, display_name, added_at, id",
      "redact": [
        "id"
      ]
    },
    {
      "name": "club_player_private_inputs",
      "sql": "SELECT club_player_id, club_id, phone_e164, email, preset_fields, captured_at, state, resolved_player_id, resolved_at, updated_at, revision::text AS revision FROM club_player_private_inputs ORDER BY club_id, phone_e164, captured_at, club_player_id",
      "redact": [
        "club_player_id"
      ]
    },
    {
      "name": "player_contact_change_requests",
      "sql": "SELECT id, player_id, field, status, proposed_value, reviewed_by_admin_id, reviewed_at, rejected_at, superseded_at, resolution_note, updated_at, revision::text AS revision FROM player_contact_change_requests ORDER BY id",
      "redact": []
    },
    {
      "name": "admin_player_email_edits",
      "sql": "SELECT id, player_id, admin_id, original_email, proposed_email, contact_revision::text AS contact_revision, state, updated_at FROM admin_player_email_edits ORDER BY player_id, proposed_email, state, id",
      "redact": [
        "id"
      ]
    },
    {
      "name": "admin_audit_events",
      "sql": "SELECT id, actor_admin_id, action, target_type, target_id, source_command_id, occurred_at, metadata - 'operationId' AS metadata, (metadata ? 'operationId') AS has_operation FROM admin_audit_events ORDER BY action, occurred_at, metadata::text, target_id",
      "redact": [
        "id"
      ]
    },
    {
      "name": "audit_operations",
      "sql": "SELECT count(*) AS events, count(DISTINCT metadata->>'operationId') AS operations FROM admin_audit_events WHERE metadata ? 'operationId'",
      "redact": []
    },
    {
      "name": "player_notifications",
      "sql": "SELECT id, player_id, kind, title, body, target, source_type, (source_id IN (SELECT id FROM admin_audit_events)) AS source_is_audit, read_at FROM player_notifications ORDER BY player_id, kind, source_type, title",
      "redact": [
        "id"
      ]
    }
