  "reset": [
    "DELETE FROM player_rank_current WHERE player_id::text LIKE 'c0000000-%'",
    "DELETE FROM players WHERE id::text LIKE 'c0000000-%'",
    "UPDATE profile_banners SET shown = true, is_default = false WHERE id <> 'b0000000-0000-4000-8000-000000000001'",
    "UPDATE profile_banners SET is_default = true WHERE id = 'court'"
  ],
