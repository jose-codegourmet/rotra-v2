{
  "name": "@rotra/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "node src/scripts/prepare.ts && playwright test",
    "e2e:ui": "node src/scripts/prepare.ts && E2E_WATCH=${E2E_WATCH:-1} playwright test --ui",
    "e2e:prepare": "node src/scripts/prepare.ts",
    "e2e:report": "playwright show-report playwright-report",
    "lint": "biome check .",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@rotra/config": "workspace:*",
    "@types/node": "^24",
    "typescript": "^5.9.3"
  }
}
