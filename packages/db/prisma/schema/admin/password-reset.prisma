// Private Admin-reviewed player recovery. The provider owns passwords and token expiry.
enum PasswordResetRequestStatus {
  pending
  issued
  declined

  @@map("password_reset_request_status")
}

model PlayerPasswordResetRequest {
  id                String                     @id @default(uuid(7)) @db.Uuid
  email             String
  playerId          String?                    @map("player_id") @db.Uuid
  status            PasswordResetRequestStatus @default(pending)
  requestedAt       DateTime                   @default(now()) @map("requested_at") @db.Timestamptz(6)
  reviewedByAdminId String?                    @map("reviewed_by_admin_id") @db.Uuid
  reviewedAt        DateTime?                  @map("reviewed_at") @db.Timestamptz(6)
  authSubject       String?                    @map("auth_subject") @db.Uuid
  /// SHA-256 of the provider's bearer token hash, never the usable secret itself.
  tokenDigest       Bytes?                     @unique @map("token_digest")
  issuanceId        String?                    @map("issuance_id") @db.Uuid
  issuanceStartedAt DateTime?                  @map("issuance_started_at") @db.Timestamptz(6)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  revision          BigInt                     @default(1)
  consumedAt        DateTime?                  @map("consumed_at") @db.Timestamptz(6)

  player     Player?       @relation(fields: [playerId], references: [id], onDelete: Restrict)
  reviewedBy AdminAccount? @relation(fields: [reviewedByAdminId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt(sort: Desc)])
  @@index([requestedAt(sort: Desc), id])
  @@index([playerId])
  @@index([reviewedByAdminId])
  @@map("player_password_reset_requests")
}
