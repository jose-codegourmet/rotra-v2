{
  "name": "@rotra/rules-wasm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The bucket 1 queue rules built from Go to WebAssembly, with a typed synchronous wrapper. Generated from apps/api; do not edit wasm/ by hand.",
  "exports": {
    "./rules": "./src/rules.ts",
    "./engine": "./src/engine.ts",
    "./types": "./src/types.ts",
    "./node": "./src/node.ts",
    "./browser": "./src/browser.ts",
    "./fingerprint": "./fingerprint.mjs",
    "./wasm/*": "./wasm/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:wasm": "node build.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@rotra/config": "workspace:*",
    "@rotra/rule-cases": "workspace:*",
    "@types/node": "^24",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
