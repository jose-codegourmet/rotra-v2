// Slot transfers (#1011, epic #1009, D-2026-11-22-03; queue/modules/sessions-roster.md).
//
// A confirmed signed-in Player asks to hand their slot to another registered ROTRA player before the
// session starts; the Queue Master approves or rejects it on the club account. Approval releases the
// sender's roster entry (reason `transferred`) and gives the slot to the recipient in the same
// transaction under the session row lock: capacity never changes and no second registration is made.
// A row is immutable once it leaves `pending` (trigger in SQL), so repeat transfers read as a chain:
// the next transfer's `sender_session_player_id` is the previous one's `recipient_session_player_id`.
//
// Shape kept ready for the later tickets of the epic, none of it built yet:
// - #1012 transfer links: a link table keyed on (club_id, session_id, id) of this row, plus a nullable
//   link column here; `recipient_player_id` is already nullable for a link nobody has claimed.
// - #1013 accounting: nullable snapshot columns (amount paid, waived amount) written by the same
//   approval UPDATE that leaves `pending`; the sender's payment mark is never touched.
// - #1014 refunds: a separate append-only refund record referencing this row.

enum SlotTransferStatus {
  pending
  approved
  rejected
  /// The sender withdrew it while pending (with transfer links, #1012, also the recipient)
  withdrawn
  /// Still pending when the session started (Start closes every pending transfer)
  expired
  /// Closed by the system: the whole session was cancelled (later also a party leaving the club, #1018)
  cancelled

  @@map("slot_transfer_status")
}

/// Request to transfer a confirmed slot (#1011). One pending transfer per sender roster entry
/// (partial unique index in SQL). Final once decided: UPDATE and DELETE of a row that is not pending
/// are refused by a trigger.
model SessionSlotTransfer {
  id                       String             @id @db.Uuid
  clubId                   String             @map("club_id") @db.Uuid
  sessionId                String             @map("session_id") @db.Uuid
  /// The slot being transferred: the sender's live roster entry when they asked.
  senderSessionPlayerId    String             @map("sender_session_player_id") @db.Uuid
  /// The sender's saved player in this club and their account, frozen at request time.
  senderClubPlayerId       String             @map("sender_club_player_id") @db.Uuid
  senderPlayerId           String             @map("sender_player_id") @db.Uuid
  /// The registered ROTRA player picked by exact RTR ID. Nullable only for a transfer link nobody
  /// has claimed yet (#1012); every #1011 request sets it, and approval requires it (CHECK).
  recipientPlayerId        String?            @map("recipient_player_id") @db.Uuid
  /// Set on approval: the recipient's saved player in this club (created when new to the club) and
  /// the roster entry that now holds the slot.
  recipientClubPlayerId    String?            @map("recipient_club_player_id") @db.Uuid
  recipientSessionPlayerId String?            @map("recipient_session_player_id") @db.Uuid
  /// Set on approval: the recipient was promoted out of the waitlist (their waitlist row deleted).
  recipientWasWaitlisted   Boolean?           @map("recipient_was_waitlisted")
  status                   SlotTransferStatus @default(pending)
  requestedAt              DateTime           @map("requested_at") @db.Timestamptz(6)
  /// When it left `pending`, for every final status.
  decidedAt                DateTime?          @map("decided_at") @db.Timestamptz(6)
  /// Device that approved or rejected it, from the same club; null when decided online in real mode
  /// and for system closes (expired, cancelled).
  decidedByDeviceId        String?            @map("decided_by_device_id") @db.Uuid
  /// The Player who withdrew it; set exactly when `withdrawn`.
  withdrawnByPlayerId      String?            @map("withdrawn_by_player_id") @db.Uuid
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  session             QueueSession   @relation(fields: [clubId, sessionId], references: [clubId, id], onDelete: Restrict)
  senderEntry         SessionPlayer  @relation("SlotTransferSender", fields: [clubId, sessionId, senderSessionPlayerId], references: [clubId, sessionId, id], onDelete: Restrict)
  senderClubPlayer    ClubPlayer     @relation("SlotTransferSender", fields: [clubId, senderClubPlayerId], references: [clubId, id], onDelete: Restrict)
  senderPlayer        Player         @relation("SlotTransferSender", fields: [senderPlayerId], references: [id], onDelete: Restrict)
  recipientPlayer     Player?        @relation("SlotTransferRecipient", fields: [recipientPlayerId], references: [id], onDelete: Restrict)
  recipientClubPlayer ClubPlayer?    @relation("SlotTransferRecipient", fields: [clubId, recipientClubPlayerId], references: [clubId, id], onDelete: Restrict)
  recipientEntry      SessionPlayer? @relation("SlotTransferRecipient", fields: [clubId, sessionId, recipientSessionPlayerId], references: [clubId, sessionId, id], onDelete: Restrict)
  decidedBy           Device?        @relation(fields: [clubId, decidedByDeviceId], references: [clubId, id], onDelete: Restrict)
  withdrawnBy         Player?        @relation("SlotTransferWithdrawnBy", fields: [withdrawnByPlayerId], references: [id], onDelete: Restrict)

  /// Scoped target for later rows that belong to one transfer (links #1012, refunds #1014).
  @@unique([clubId, sessionId, id])
  @@index([sessionId, status, requestedAt])
  @@index([clubId, sessionId, senderSessionPlayerId])
  @@index([clubId, sessionId, recipientSessionPlayerId])
  @@index([senderPlayerId])
  @@index([recipientPlayerId])
  @@map("session_slot_transfers")
}
