# Go API environment: placeholders only. Copy to .env.local (gitignored), never commit a real value.
# Guide: docs/backend/environment-setup.md · Google: docs/backend/google-sign-in-setup.md

# --- Required ---
DATABASE_URL=postgres://user:password@localhost:5432/rotra_local

# --- Needed for most routes ---
# Same value as the apps' ROTRA_PROXY_SECRET. Without it every route except /healthz answers 404.
ROTRA_PROXY_SECRET=
# Sign-in passes. Generate with: cd apps/api && go run ./cmd/authkey (paste only the ROTRA_AUTH_SIGNING_KEY value).
# Without it the API still starts but serves no sign-in routes.
ROTRA_AUTH_SIGNING_KEY=
# Same value as the Next apps' ROTRA_VISITOR_RECEIPT_SECRET (openssl rand -base64 32, no trailing space or newline).
ROTRA_VISITOR_RECEIPT_SECRET=
ROTRA_ALLOWED_ORIGINS=http://localhost:9000,http://localhost:9001,http://localhost:9002
# Exact Queue app origins, no * and no trailing slash.
ROTRA_QUEUE_ORIGINS=http://localhost:9000

# --- Google sign-in for players (optional) ---
# All three or none. The API NEVER fails to start over these: with none, or only some, or a redirect base that is not an
# origin, Google sign-in stays off, the API logs why (a warning), and Continue with Google answers "unavailable".
# It also stays off until the player_google_sign_in flag is on (Admin > Settings > Feature flags).
# Client: a Google Cloud OAuth client of type Web application, scopes openid, email, profile only.
# Authorized redirect URI there: <GOOGLE_OAUTH_REDIRECT_BASE>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The Player app's own origin: https://player.rotra.club or http://localhost:9001 (no path, no trailing slash).
GOOGLE_OAUTH_REDIRECT_BASE=
# Limit for finished Google trips per IP, "<max>/<window>" such as 100/15m, like the other ROTRA_AUTH_LIMIT_* values (default 100 per 15 minutes).
# ROTRA_AUTH_LIMIT_GOOGLE_TRIP_IP=100/15m

# --- Live updates (B-26, B-43, B-48) ---
# A direct (unpooled) connection string for the LISTEN connection: PgBouncer does not support LISTEN/NOTIFY. Unset: DATABASE_URL is
# used (fine locally, wrong behind PgBouncer; the API logs a warning).
# DATABASE_DIRECT_URL=
# A transaction left idle this long is ended, because a write left open delays every live update (default 5s, 0 turns it off).
# Also set it on the API's database role: ALTER ROLE rotra_api SET idle_in_transaction_session_timeout = '5s';
# DB_IDLE_IN_TX_TIMEOUT=5s
# Starting limits (B-43): open streams per client IP, open streams in total, stream tickets per IP a minute. Signed-in screens are never limited.
# STREAM_MAX_PER_IP=50
# STREAM_MAX_TOTAL=3000
# STREAM_TICKETS_PER_MINUTE=60

# --- Optional tuning: defaults apply when unset (see apps/api/README.md) ---
# PORT=8080
# LOG_LEVEL=info
# DB_MAX_CONNS=
# SHUTDOWN_TIMEOUT=
# ROTRA_AUTH_HASH_CONCURRENCY=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
