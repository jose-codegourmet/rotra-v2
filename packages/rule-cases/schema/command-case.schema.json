{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "command"
    },
    "command": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "$ref": "#/$defs/__schema0"
          },
          "args": {
            "$ref": "#/$defs/__schema1"
          },
          "operationId": {
            "type": "string",
            "minLength": 1
          },
          "now": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "expected": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "after": {
                    "$ref": "#/$defs/__schema2"
                  }
                },
                "required": ["after"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "rejected": {
                    "$ref": "#/$defs/__schema3"
                  }
                },
                "required": ["rejected"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["name", "before", "args", "operationId", "now", "expected"],
        "additionalProperties": false
      }
    }
  },
  "required": ["kind", "command", "version", "cases"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
