{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "queue": {
      "root": "apps/queue",
      "framework": "nextjs"
    },
    "player": {
      "root": "apps/player",
      "framework": "nextjs"
    },
    "admin": {
      "root": "apps/admin",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "queue.rotra.club" }],
      "destination": { "service": "queue" }
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "player.rotra.club" }],
      "destination": { "service": "player" }
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.rotra.club" }],
      "destination": { "service": "admin" }
    }
  ]
}
