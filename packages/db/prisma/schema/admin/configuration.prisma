// Feature flags and ranking policy versions (admin/modules/configuration-requests.md).
// No flag consumers and no ranking calculation live here.

/// Owner-created flag. The catalog starts empty; the key is immutable (trigger in SQL).
model FeatureFlag {
  /// ^[a-z][a-z0-9_]{2,39}$ (CHECK in SQL).
  key              String   @id
  /// Up to 50 characters, unique.
  name             String   @unique @db.VarChar(50)
  description      String
  value            Boolean  @default(false)
  createdByAdminId String   @map("created_by_admin_id") @db.Uuid
  updatedByAdminId String   @map("updated_by_admin_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  revision         BigInt   @default(1)

  createdBy AdminAccount @relation("FeatureFlagCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  updatedBy AdminAccount @relation("FeatureFlagUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: Restrict)

  @@index([createdByAdminId])
  @@index([updatedByAdminId])
  @@map("feature_flags")
}

/// Append-only saved ranking settings (UPDATE/DELETE rejected by trigger). The newest effective
/// version is in effect. A version records configuration only; it is never evidence that any rank
/// was recalculated (retroactivity is pending #247).
model RankingPolicyVersion {
  id                           String   @id @default(uuid(7)) @db.Uuid
  /// 1, 2, 3… in save order.
  version                      Int      @unique
  effectiveAt                  DateTime @map("effective_at") @db.Timestamptz(6)
  /// Basis points 0–10000; the two sum to 10000 (CHECK in SQL).
  assessmentWeightBp           Int      @map("assessment_weight_bp") @db.SmallInt
  performanceWeightBp          Int      @map("performance_weight_bp") @db.SmallInt
  /// Recent standard matches the leaderboard requires, 1–40.
  recentStandardMatchThreshold Int      @map("recent_standard_match_threshold") @db.SmallInt
  /// Reference to the approved algorithm version (#247); not a calculation result.
  algorithmVersion             String   @map("algorithm_version")
  createdByAdminId             String?  @map("created_by_admin_id") @db.Uuid
  changeNote                   String?  @map("change_note")
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy AdminAccount? @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)

  finalizations   SessionFinalization[]
  rankProjections PlayerRankCurrent[]

  @@index([effectiveAt(sort: Desc)])
  @@index([createdByAdminId])
  @@map("ranking_policy_versions")
}

/// The one Admin settings row (id = 1, CHECK and seed in SQL). Sales reads the cost per session from
/// it (D-2026-11-08-01); ₱15 is a placeholder until the owner sets the real figure.
model AdminSetting {
  /// Always 1: a fixed key so only one row can exist (CHECK in SQL).
  id                  Int      @id @default(1) @db.SmallInt
  /// Estimated cost to ROTRA of one session, centavos ≥ 0 (CHECK in SQL).
  costPerSessionMinor Int      @default(1500) @map("cost_per_session_minor")
  currency            String   @default("PHP") @db.Char(3)
  /// Null for the seeded row, which no admin saved.
  updatedByAdminId    String?  @map("updated_by_admin_id") @db.Uuid
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  revision            BigInt   @default(1)

  updatedBy AdminAccount? @relation(fields: [updatedByAdminId], references: [id], onDelete: Restrict)

  @@index([updatedByAdminId])
  @@map("admin_settings")
}
