{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "git": {
    "deploymentEnabled": false
  },
  "services": {
    "mockup": {
      "root": "apps/mockup",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist/public",
      "redirects": [
        { "source": "/queue-app/rotra-queue.html", "destination": "/queue", "permanent": false },
        { "source": "/player-app/rotra-player.html", "destination": "/player", "permanent": false },
        { "source": "/admin-app/rotra-admin.html", "destination": "/admin", "permanent": false }
      ],
      "rewrites": [
        { "source": "/queue/:path*", "destination": "/queue-app/rotra-queue.html" },
        { "source": "/player/:path*", "destination": "/player-app/rotra-player.html" },
        { "source": "/admin/:path*", "destination": "/admin-app/rotra-admin.html" }
      ]
    },
    "queue": {
      "root": "apps/queue",
      "framework": "nextjs"
    },
    "player": {
      "root": "apps/player",
      "framework": "nextjs"
    },
    "admin": {
      "root": "apps/admin",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mockup.rotra.club" }],
      "destination": { "service": "mockup" }
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "queue.rotra.club" }],
      "destination": { "service": "queue" }
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "player.rotra.club" }],
      "destination": { "service": "player" }
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.rotra.club" }],
      "destination": { "service": "admin" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "mockup" }
    }
  ]
}
