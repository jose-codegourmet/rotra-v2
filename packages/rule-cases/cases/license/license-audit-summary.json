            "endsAt": "2026-11-02",
            "amountMinor": 150000,
            "currency": "PHP",
            "paidOn": "2026-10-03",
            "paymentReference": "LIC-0009",
            "activatedAt": "2026-10-03T09:00:00+08:00",
            "activatedByEmail": "owner@rotra.example",
            "sourceCommandId": "cmd-2026-10-03"
          }
        ]
      },
      "expected": "Renewed license: Monthly, Oct 3 – Nov 2, 2026 · ₱1,500 · LIC-0009."
    },
    {
      "name": "amounts › writes the record line with the reference and the retention sentence (license) #2",
      "input": {
        "args": [
          "Renewed",
          {
            "id": "2026-10-03-Monthly",
            "clubId": "club",
            "plan": "Monthly",
            "startsAt": "2026-10-03",
            "endsAt": "2026-11-02",
            "amountMinor": 150000,
            "currency": "PHP",
            "paidOn": "2026-10-03",
            "paymentReference": "LIC-0009",
            "activatedAt": "2026-10-03T09:00:00+08:00",
